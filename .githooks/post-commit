#!/bin/bash
# Auto version bump + release branch + push on commits to main
#
# On every commit to main (except version bumps themselves):
# 1. Bumps patch version in VERSION file
# 2. Commits the version bump
# 3. Creates tag v{version}
# 4. Creates branch release/{version}
# 5. Pushes main, tag, and branch to origin

set -e

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$BRANCH" != "main" ]; then
    exit 0
fi

# Prevent infinite loop
LAST_MSG=$(git log -1 --pretty=%s)
if echo "$LAST_MSG" | grep -q "^chore(release):"; then
    exit 0
fi

if [ "$VERSION_BUMP_IN_PROGRESS" = "1" ]; then
    exit 0
fi

export VERSION_BUMP_IN_PROGRESS=1

VERSION_FILE="$(git rev-parse --show-toplevel)/VERSION"
if [ ! -f "$VERSION_FILE" ]; then
    echo "⚠️  VERSION file not found, skipping version bump"
    exit 0
fi

# Read and bump version
CURRENT=$(cat "$VERSION_FILE" | tr -d '[:space:]')
MAJOR=$(echo "$CURRENT" | cut -d. -f1)
MINOR=$(echo "$CURRENT" | cut -d. -f2)
PATCH=$(echo "$CURRENT" | cut -d. -f3)
NEW_PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${NEW_PATCH}"

# Update VERSION file and commit
echo "$NEW_VERSION" > "$VERSION_FILE"
git add "$VERSION_FILE"
git commit -m "chore(release): ${NEW_VERSION}"

# Create tag and release branch
git tag "v${NEW_VERSION}"
git branch "release/${NEW_VERSION}"

# Push everything to remote
git push origin main "release/${NEW_VERSION}" --tags 2>/dev/null \
    || echo "⚠️  Auto-push failed. Run: git push origin main release/${NEW_VERSION} --tags"

echo "✅ Version bumped: ${CURRENT} → ${NEW_VERSION}"
echo "✅ Tag v${NEW_VERSION} + branch release/${NEW_VERSION} created and pushed"
