    },
    "line_height": {
      "default": 1.5,
      "maximum": 2.5,
      "minimum": 1,
      "title": "Line Height",
      "type": "number"
    },
    "margin_mm": {
      "default": 20,
      "maximum": 40,
      "minimum": 5,
      "title": "Margin Mm",
