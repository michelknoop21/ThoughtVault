{
  "additionalProperties": false,
  "properties": {
    "font": {
      "default": "Arial",
      "enum": [
        "Arial",
        "Georgia",
        "Verdana",
        "Times New Roman"
      ],
      "title": "Font",
      "type": "string"
    },
    "size": {
      "default": 11,
      "maximum": 32,
      "minimum": 8,
      "title": "Size",
      "type": "number"
    },
    "text_color": {
      "default": "#222222",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "title": "Text Color",
      "type": "string"
    },
    "accent_color": {
      "default": "#3454d1",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "title": "Accent Color",
