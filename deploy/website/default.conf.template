server {
    listen 80;
    server_name thoughtvault.yinga.ai;
    root /usr/share/nginx/html;
    server_tokens off;
    # Relative Location headers: behind Caddy nginx only sees http on port 80.
    absolute_redirect off;
    # Do not persist capability URLs in access logs.
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    location = /healthz { return 200 'ok'; }
    location = /d-${DOWNLOAD_TOKEN} { return 404; }
    location = /d-${DOWNLOAD_TOKEN}/ {
        root /usr/share/nginx/private;
        rewrite ^ /index.html break;
        add_header X-Robots-Tag 'noindex, nofollow, noarchive, nosnippet' always;
        add_header Cache-Control 'private, no-store' always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /download.js {
        alias /usr/share/nginx/private/download.js;
        add_header X-Robots-Tag 'noindex, nofollow' always;
    }
    location = /d-${DOWNLOAD_TOKEN}/releases.json {
        alias /srv/releases/releases.json;
        add_header X-Robots-Tag 'noindex, nofollow, noarchive, nosnippet' always;
        add_header Cache-Control 'private, no-store' always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
    }
    # Help centre (handleiding and release notes), built by scripts/build-helpcentrum.py.
    location = /d-${DOWNLOAD_TOKEN}/help { return 301 /d-${DOWNLOAD_TOKEN}/help/; }
    location /d-${DOWNLOAD_TOKEN}/help/ {
        alias /usr/share/nginx/help/;
        index index.html;
        add_header X-Robots-Tag 'noindex, nofollow, noarchive, nosnippet' always;
        add_header Cache-Control 'private, no-cache' always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
    }
    location /d-${DOWNLOAD_TOKEN}/ {
        alias /srv/releases/;
        autoindex off;
        add_header X-Robots-Tag 'noindex, nofollow, noarchive, nosnippet' always;
        add_header Cache-Control 'private, no-store' always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
    }
    location /assets/ {
        add_header Cache-Control 'public, max-age=604800' always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }
    location / {
        add_header Cache-Control 'no-cache' always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri $uri/ =404;
    }
}
